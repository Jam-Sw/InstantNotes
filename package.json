{
  "name": "instantnotes",
  "version": "0.8.0",
  "description": "InstantNotes — instant capture, organized knowledge",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
