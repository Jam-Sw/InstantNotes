    "test": "vitest run",
    "tauri": "tauri",
    "tauri:dev": "node scripts/tauri-dev.mjs",
    "bump": "node scripts/bump-version.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@codemirror/commands": "^6",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
